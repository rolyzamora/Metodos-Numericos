Z_th = 150.0
g = lambda x: cs(x) - Z_th
g_vals = g(f_fine)
root_brackets = []
for i in range(len(f_fine)-1):
    if g_vals[i]*g_vals[i+1] < 0:
        root_brackets.append((f_fine[i], f_fine[i+1]))
 
def biseccion(g, a, b, tol=1e-6, max_iter=200):
    fa = g(a)
    hist = []
    for _ in range(max_iter):
        c = (a+b)/2.0
        fc = g(c)
        hist.append(abs(fc))
        if abs(fc) < tol or (b-a)/2 < tol:
            break
        if fa*fc < 0: b = c
        else: a, fa = c, fc
    return c, hist
 
def newton_raphson(g, x0, tol=1e-6, max_iter=100):
    x = x0
    hist = []
    for _ in range(max_iter):
        fx = g(x)
        hist.append(abs(fx))
        if abs(fx) < tol: break
        dfx = float(cs(x, 1))
        if dfx == 0: break
        x = x - fx/dfx
    return x, hist
 
for a, b in root_brackets:
    r_b, _ = biseccion(g, a, b)
    r_n, _ = newton_raphson(g, (a+b)/2)
    print(f"Bisección: {r_b:.4f} Hz | NR: {r_n:.4f} Hz | |Z|={float(cs(r_b)):.4f} Ω")
 
root_2000 = None
for a, b in root_brackets:
    r_b, _ = biseccion(g, a, b)
    if r_b > 1800:
        root_2000 = r_b; break
 
