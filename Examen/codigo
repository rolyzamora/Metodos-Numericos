def poly_matrix(x_nodes, y_nodes, degree):
    A = np.vander(x_nodes, degree+1, increasing=False)
    coeffs, _, _, _ = np.linalg.lstsq(A, y_nodes, rcond=None)
    return coeffs
 
def poly_eval(coeffs, x):
    return np.polyval(coeffs, x)
 
def lagrange_eval(x_nodes, y_nodes, x_eval):
    n = len(x_nodes)
    x_eval = np.atleast_1d(x_eval)
    result = np.zeros(len(x_eval))
    for i in range(n):
        L = np.ones(len(x_eval))
        for j in range(n):
            if j != i:
                L *= (x_eval - x_nodes[j]) / (x_nodes[i] - x_nodes[j])
        result += y_nodes[i] * L
    return result
 
coeffs29 = poly_matrix(f, Z, 29)
Z_poly29 = poly_eval(coeffs29, f_fine)
 
def piecewise_poly(x_all, y_all, x_eval, npts):
    result = np.full(len(x_eval), np.nan)
    n = len(x_all)
    step = max(npts-1, 1)
    for start in range(0, n, step):
        end = min(start+npts, n)
        seg_x = x_all[start:end]
        seg_y = y_all[start:end]
        mask = (x_eval >= seg_x[0]) & (x_eval <= seg_x[-1])
        if mask.any() and len(seg_x) > 1:
            deg = len(seg_x)-1
            coeffs = poly_matrix(seg_x, seg_y, deg)
            result[mask] = poly_eval(coeffs, x_eval[mask])
    return result
 
Z_step5  = piecewise_poly(f, Z, f_fine, 6)
Z_step10 = piecewise_poly(f, Z, f_fine, 11)
Z_step15 = piecewise_poly(f, Z, f_fine, 16)
 
